{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "prettier.proseWrap": "never",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.rulers": []
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.wordWrap": "on",
