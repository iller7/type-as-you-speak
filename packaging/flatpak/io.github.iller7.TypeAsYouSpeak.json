{
  "id": "io.github.iller7.TypeAsYouSpeak",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "name": "Type As You Speak",
  "command": "tays",
  "copy-icon": true,
  "appstream": true,
  "no-debuginfo": true,
  "finish-args": [
    "--socket=wayland",
    "--socket=x11",
    "--socket=pulseaudio",
    "--share=ipc",
    "--share=network",
    "--device=all",
    "--filesystem=xdg-config",
    "--filesystem=xdg-cache",
    "--talk-name=org.freedesktop.Notifications",
    "--env=HF_HUB_DISABLE_TELEMETRY=1"
  ],
  "build-options": {
    "env": {
      "PIP_DISABLE_PIP_VERSION_CHECK": "1",
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  },
  "extensions": {
    "org.freedesktop.Platform.ffmpeg8": {
      "version": "24.08",
      "add-ld-path": "/lib"
    }
  },
  "modules": [
    {
      "name": "ydotool",
      "buildsystem": "cmake",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/ReimuNotMoe/ydotool",
          "tag": "v1.0.4"
        }
      ]
    },
    {
      "name": "wl-clipboard",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/bugaevc/wl-clipboard",
          "tag": "v2.3.0"
        }
      ]
    },
    {
      "name": "type-as-you-speak",
      "buildsystem": "simple",
      "autogen": false,
      "build-commands": [
        "pip install --no-cache-dir --no-build-isolation --prefix=/app .",
        "install -Dm644 data/type-as-you-speak.desktop /app/share/applications/io.github.iller7.TypeAsYouSpeak.desktop",
        "install -Dm644 data/type-as-you-speak.metainfo.xml /app/share/metainfo/io.github.iller7.TypeAsYouSpeak.metainfo.xml",
        "install -Dm644 data/icons/type-as-you-speak-512.png /app/share/icons/hicolor/512x512/apps/type-as-you-speak.png",
        "install -Dm644 data/icons/type-as-you-speak-256.png /app/share/icons/hicolor/256x256/apps/type-as-you-speak.png",
        "install -Dm644 data/icons/type-as-you-speak-128.png /app/share/icons/hicolor/128x128/apps/type-as-you-speak.png",
        "install -Dm644 data/icons/type-as-you-speak-64.png /app/share/icons/hicolor/64x64/apps/type-as-you-speak.png",
        "install -Dm644 data/icons/type-as-you-speak-32.png /app/share/icons/hicolor/32x32/apps/type-as-you-speak.png",
        "install -Dm644 README.md LICENSE /app/share/doc/io.github.iller7.TypeAsYouSpeak/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/iller7/type-as-you-speak",
          "tag": "v0.5.0"
        }
      ]
    }
  ]
}
