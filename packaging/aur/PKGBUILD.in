# Maintainer: Faizal Sahebdin <faizal.sahebdin@gmail.com>
#
# type-as-you-speak — Mac-like, real-time dictation for Linux (Wayland & X11).
# 100% local: faster-whisper runs on your machine, your audio never leaves it,
# and it works offline after the first model download (~484 MB, small.en).

pkgname=type-as-you-speak
pkgver=0.5.2
pkgrel=1
pkgdesc="Mac-like, type-as-you-speak dictation for Linux (Wayland & X11) — 100% local"
arch=(x86_64)
url="https://github.com/iller7/type-as-you-speak"
license=(AGPL-3.0-only)

depends=(
  "python>=3.11"
  "python<3.15"
  # Resolve distro/AUR Python dependencies before building this package.
  python-numpy
  python-pyside6
  python-tomlkit
  python-faster-whisper
  python-onnxruntime
  # Runtime tools:
  ydotool        # keystroke injection (daemon: ydotoold)
  wl-clipboard   # clipboard fallback on Wayland
  xclip          # clipboard fallback on X11
  ffmpeg         # mic capture (pulse input)
  libpulse
  libnotify
  libseccomp
)
makedepends=(python-build python-installer python-setuptools python-wheel)

# Render with the checked source archive and its SHA-256 before running makepkg.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  cd "$pkgname-$pkgver"
  # Arch already packages the Python dependencies, so bundle only the app code.
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # Launcher (wrapper so the shebang is env-clean).
  install -Dm755 /dev/null "$pkgdir/usr/bin/tays"
  cat > "$pkgdir/usr/bin/tays" <<'EOF'
#!/usr/bin/env python3
import sys
from type_as_you_speak.cli import main
sys.exit(main())
EOF

  # Desktop entry, AppStream metadata, icon, docs.
  install -Dm644 data/type-as-you-speak.desktop \
    "$pkgdir/usr/share/applications/type-as-you-speak.desktop"
  install -Dm644 data/type-as-you-speak.metainfo.xml \
    "$pkgdir/usr/share/metainfo/type-as-you-speak.metainfo.xml"
  for size in 512 256 128 64 32; do
    install -Dm644 "data/icons/type-as-you-speak-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/type-as-you-speak.png"
  done
  install -dm755 "$pkgdir/usr/share/doc/$pkgname"
  install -m644 README.md LICENSE NOTICE COMMERCIAL.md "$pkgdir/usr/share/doc/$pkgname/"
}
